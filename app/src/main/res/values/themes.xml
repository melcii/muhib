<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Muhib" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:fontFamily">?attr/fontRegular</item>
        <item name="fontRegular">@font/inter</item>
        <item name="fontLight">@font/inter_light</item>
        <item name="fontMedium">@font/inter_medium</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Muhib.Label" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:fontFamily">?attr/fontMedium</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Muhib.Body" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">?attr/fontRegular</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:fallbackLineSpacing" tools:targetApi="28">false</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <style name="Muhib.Title" parent="">
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">?attr/fontLight</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Muhib.Link" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:fontFamily">?attr/fontMedium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="Muhib.Pill" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">?attr/fontMedium</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:background">@drawable/pill_bg</item>
    </style>

    <style name="Muhib.Button" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:fontFamily">?attr/fontMedium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:background">@drawable/button_bg</item>
    </style>

    <style name="Muhib.RowText" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">?attr/fontRegular</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <style name="Muhib.Segment" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">?attr/fontMedium</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/segment_item</item>
    </style>

    <style name="Muhib.Tab" parent="Muhib.Segment">
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Muhib.Card" parent="">
        <item name="android:background">@drawable/group_bg</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Muhib.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Muhib.Icon" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="WidgetCol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="WidgetName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WidgetTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.Muhib.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
    </style>

    <!-- Font choices, laid over the theme. Only fonts built into Android, so widgets can match. -->
    <style name="Font.Serif" parent="">
        <item name="fontRegular">serif</item>
        <item name="fontLight">serif</item>
        <item name="fontMedium">serif</item>
    </style>
    <style name="Font.Airy" parent="">
        <item name="fontRegular">sans-serif-light</item>
        <item name="fontLight">sans-serif-thin</item>
        <item name="fontMedium">sans-serif</item>
    </style>
    <!-- Cutive Mono, a real typewriter face with every Turkish letter, for reading. It's wide, so
         times and labels stay in a clean sans and still fit. -->
    <style name="Font.Mono" parent="">
        <item name="fontRegular">serif-monospace</item>
        <item name="fontLight">serif-monospace</item>
        <item name="fontMedium">sans-serif-medium</item>
    </style>
    <!-- Dancing Script for reading; labels, buttons and times stay in a clean sans. (Coming Soon,
         the "casual" family, lacks ğ, ş and İ.) -->
    <style name="Font.Playful" parent="">
        <item name="fontRegular">cursive</item>
        <item name="fontLight">cursive</item>
        <item name="fontMedium">sans-serif-medium</item>
    </style>
</resources>
