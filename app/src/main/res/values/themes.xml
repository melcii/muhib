<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Muhib" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Muhib.Label" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Muhib.Body" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
        <item name="android:fallbackLineSpacing" tools:targetApi="28">false</item>
    </style>

    <style name="Muhib.Title" parent="">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/inter_light</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Muhib.Link" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="Muhib.Pill" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:background">@drawable/pill_bg</item>
    </style>

    <style name="Muhib.Button" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:background">@drawable/button_bg</item>
    </style>

    <style name="Muhib.RowText" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Muhib.Segment" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/segment_item</item>
    </style>
</resources>
