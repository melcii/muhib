<?xml version="1.0" encoding="utf-8"?>
<!-- The next prayer and the day's times on top, the reminder underneath. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/pin"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pin_small" />

            <TextView
                android:id="@+id/city"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <LinearLayout style="@style/WidgetCol">
                <TextView android:id="@+id/n0" style="@style/WidgetName" />
                <TextView android:id="@+id/t0" style="@style/WidgetTime" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetCol">
                <TextView android:id="@+id/n1" style="@style/WidgetName" />
                <TextView android:id="@+id/t1" style="@style/WidgetTime" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetCol">
                <TextView android:id="@+id/n2" style="@style/WidgetName" />
                <TextView android:id="@+id/t2" style="@style/WidgetTime" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetCol">
                <TextView android:id="@+id/n3" style="@style/WidgetName" />
                <TextView android:id="@+id/t3" style="@style/WidgetTime" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetCol">
                <TextView android:id="@+id/n4" style="@style/WidgetName" />
                <TextView android:id="@+id/t4" style="@style/WidgetTime" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetCol">
                <TextView android:id="@+id/n5" style="@style/WidgetName" />
                <TextView android:id="@+id/t5" style="@style/WidgetTime" />
            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/rule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:background="#FFFFFFFF" />

        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:animateFirstView="false"
            android:inAnimation="@android:anim/fade_in"
            android:outAnimation="@android:anim/fade_out">

            <FrameLayout
                android:id="@+id/covered"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/blur"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/star"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_star" />

                    <TextView
                        android:id="@+id/prompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/inter_light"
                        android:maxLines="2"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/revealed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="6dp">

                <TextView
                    android:id="@+id/text"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="15sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/inter_light"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="10sp" />
            </LinearLayout>
        </ViewFlipper>
    </LinearLayout>
</FrameLayout>
