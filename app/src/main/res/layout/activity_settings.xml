<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/back"
                style="@style/Muhib.Icon"
                android:layout_marginStart="-12dp"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />
        </LinearLayout>

        <TextView
            style="@style/Muhib.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:text="@string/settings" />

        <LinearLayout
            android:id="@+id/sides"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/segment_bg"
            android:orientation="horizontal"
            android:padding="3dp">
            <TextView
                android:id="@+id/sidePrayer"
                style="@style/Muhib.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/side_prayer" />
            <TextView
                android:id="@+id/sideMuhib"
                style="@style/Muhib.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name" />
        </LinearLayout>

        <!-- The two sides; what's below them is shared -->
        <FrameLayout
            android:id="@+id/sideStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/prayerSide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/Muhib.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingStart="4dp"
                    android:text="@string/update_section" />
                <LinearLayout
                    style="@style/Muhib.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <LinearLayout
                        android:id="@+id/updateRow"
                        style="@style/Muhib.Row"
                        android:background="?android:attr/selectableItemBackground"
                        android:minHeight="68dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_globe" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                style="@style/Muhib.RowText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/update_title" />
                            <TextView
                                android:id="@+id/updateSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/muted"
                                android:textSize="13sp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/updateState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/accent"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingMultiplier="1.3"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/update_note"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
                <TextView
                    style="@style/Muhib.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:paddingStart="4dp"
                    android:text="@string/notify_section" />
                <LinearLayout
                    style="@style/Muhib.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <LinearLayout
                        android:id="@+id/notifyRow"
                        style="@style/Muhib.Row"
                        android:background="?android:attr/selectableItemBackground"
                        android:minHeight="60dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_bell" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                style="@style/Muhib.RowText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/notify_title" />
                            <TextView
                                android:id="@+id/notifySub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/muted"
                                android:textSize="13sp" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/notifySwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="58dp"
                        android:background="@color/hairline" />
                    <LinearLayout
                        android:id="@+id/beforeRow"
                        style="@style/Muhib.Row"
                        android:background="?android:attr/selectableItemBackground"
                        android:minHeight="60dp">

                        <View
                            android:layout_width="38dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                style="@style/Muhib.RowText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/notify_before" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/beforeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/accent"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="58dp"
                        android:background="@color/hairline" />
                    <LinearLayout
                        android:id="@+id/atRow"
                        style="@style/Muhib.Row"
                        android:background="?android:attr/selectableItemBackground"
                        android:minHeight="60dp">

                        <View
                            android:layout_width="38dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                style="@style/Muhib.RowText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/notify_at" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/atSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="58dp"
                        android:background="@color/hairline" />
                    <LinearLayout
                        android:id="@+id/whichRow"
                        style="@style/Muhib.Row"
                        android:background="?android:attr/selectableItemBackground"
                        android:minHeight="60dp">

                        <View
                            android:layout_width="38dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                style="@style/Muhib.RowText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/notify_which" />
                            <TextView
                                android:id="@+id/whichSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/muted"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    style="@style/Muhib.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:paddingStart="4dp"
                    android:text="@string/method" />
                <LinearLayout
                    android:id="@+id/methods"
                    style="@style/Muhib.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
                <TextView
                    style="@style/Muhib.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:paddingStart="4dp"
                    android:text="@string/asr" />
                <LinearLayout
                    style="@style/Muhib.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:background="@drawable/segment_bg"
                        android:orientation="horizontal"
                        android:padding="3dp">
                        <TextView
                            android:id="@+id/asrStandard"
                            style="@style/Muhib.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/asr_standard" />
                        <TextView
                            android:id="@+id/asrHanafi"
                            style="@style/Muhib.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/asr_hanafi" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/asr_note"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/muhibSide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/Muhib.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingStart="4dp"
                    android:text="@string/renews_label" />
                <LinearLayout
                    style="@style/Muhib.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:background="@drawable/segment_bg"
                        android:orientation="horizontal"
                        android:padding="3dp">
                        <TextView
                            android:id="@+id/renewSun"
                            style="@style/Muhib.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/renew_sun" />
                        <TextView
                            android:id="@+id/renewSet"
                            style="@style/Muhib.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/renew_set" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/renewNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingMultiplier="1.3"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/renew_sun_note"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/setTimes"
                    style="@style/Muhib.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <LinearLayout
                        android:id="@+id/morningRow"
                        style="@style/Muhib.Row"
                        android:background="?android:attr/selectableItemBackground"
                        android:minHeight="60dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sun" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                style="@style/Muhib.RowText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/morning" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/morningTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/accent"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="58dp"
                        android:background="@color/hairline" />
                    <LinearLayout
                        android:id="@+id/nightRow"
                        style="@style/Muhib.Row"
                        android:background="?android:attr/selectableItemBackground"
                        android:minHeight="60dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_moon" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                style="@style/Muhib.RowText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/night" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/nightTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/accent"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    style="@style/Muhib.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:paddingStart="4dp"
                    android:text="@string/notifications_label" />
                <LinearLayout
                    style="@style/Muhib.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <LinearLayout
                        android:id="@+id/quietRow"
                        style="@style/Muhib.Row"
                        android:background="?android:attr/selectableItemBackground"
                        android:minHeight="72dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_bell" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                style="@style/Muhib.RowText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/quiet_title" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/quiet_subtitle"
                                android:textColor="@color/muted"
                                android:textSize="13sp" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/quiet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            style="@style/Muhib.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:paddingStart="4dp"
            android:text="@string/both_sides"
            android:textColor="@color/accent" />
        <TextView
            style="@style/Muhib.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="4dp"
            android:text="@string/accent_section" />
        <LinearLayout
            style="@style/Muhib.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">
            <LinearLayout
                android:id="@+id/accentSwatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="-8dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/accentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/accent"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:text="@string/accent_note"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
        <TextView
            style="@style/Muhib.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingStart="4dp"
            android:text="@string/widgets_section" />
        <LinearLayout
            style="@style/Muhib.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@drawable/segment_bg"
                android:orientation="horizontal"
                android:padding="3dp">
                <TextView
                    android:id="@+id/styleShared"
                    style="@style/Muhib.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widgets_shared" />
                <TextView
                    android:id="@+id/styleEach"
                    style="@style/Muhib.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widgets_each" />
            </LinearLayout>
            <TextView
                android:id="@+id/styleNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.3"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/widgets_shared_note"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widgetList"
            style="@style/Muhib.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
        <LinearLayout
            style="@style/Muhib.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:id="@+id/exactRow"
                style="@style/Muhib.Row"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="68dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clock" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/Muhib.RowText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exact_title" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/exact_sub"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/exactState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/accent"
                    android:textSize="14sp" />
            </LinearLayout>
            <View
                android:id="@+id/addWidgetDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="58dp"
                android:background="@color/hairline" />
            <LinearLayout
                android:id="@+id/addWidgetRow"
                style="@style/Muhib.Row"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="60dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/Muhib.RowText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_pick_title" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView
            style="@style/Muhib.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingStart="4dp"
            android:text="@string/language" />
        <LinearLayout
            style="@style/Muhib.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingTop="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_globe" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/segment_bg"
                    android:orientation="horizontal"
                    android:padding="3dp">
                    <TextView
                        android:id="@+id/langEn"
                        style="@style/Muhib.Segment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lang_en" />
                    <TextView
                        android:id="@+id/langTr"
                        style="@style/Muhib.Segment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lang_tr" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/credits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:lineSpacingMultiplier="1.35"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
